@api_HostAddress = https://localhost:7095
@ledger = {{api_HostAddress}}/v1/ledger
@instruments = {{api_HostAddress}}/v1/instruments
@financing = {{api_HostAddress}}/v1/financing
@subscriptions = {{api_HostAddress}}/v1/subscriptions

### Liveness probe (temporary — replaced by the real health check in Phase 8)
GET {{api_HostAddress}}/health
Accept: application/json

### Seed a bank account (Development-only endpoint)
# @name bankAccount
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Bank", "type": "Asset", "kind": "Bank" }

### Seed a cash account (Development-only endpoint)
# @name cashAccount
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Cash", "type": "Asset", "kind": "Cash" }

### Seed an expense account (Development-only endpoint)
# @name expenseAccount
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Groceries", "type": "Expense", "kind": "Expense" }

### Seed a receivable account (Development-only endpoint)
# @name receivableAccount
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Roommate", "type": "Asset", "kind": "Receivable" }

### Post a balanced transaction — Dr Groceries 1000 / Cr Bank 1000
# @name postedTransaction
POST {{ledger}}/transactions
Content-Type: application/json

{
  "lines": [
    { "accountId": "{{expenseAccount.response.body.$.accountId}}", "direction": "Debit", "amountMinorUnits": 1000 },
    { "accountId": "{{bankAccount.response.body.$.accountId}}", "direction": "Credit", "amountMinorUnits": 1000 }
  ],
  "postedOnUtc": "2026-08-29T12:00:00Z"
}

### Bank balance — expect -1000 ("-10.00 ARS")
GET {{ledger}}/accounts/{{bankAccount.response.body.$.accountId}}/balance

### Groceries balance — expect +1000 ("10.00 ARS")
GET {{ledger}}/accounts/{{expenseAccount.response.body.$.accountId}}/balance

### Reverse the transaction — expect compensatingEntryPosted: false
POST {{ledger}}/transactions/{{postedTransaction.response.body.$.transactionId}}/reversal

### Bank balance after reversal — expect 0
GET {{ledger}}/accounts/{{bankAccount.response.body.$.accountId}}/balance

### Receivable-shaped transaction — Dr Groceries 500 + Dr Roommate 500 / Cr Bank 1000
POST {{ledger}}/transactions
Content-Type: application/json

{
  "lines": [
    { "accountId": "{{expenseAccount.response.body.$.accountId}}", "direction": "Debit", "amountMinorUnits": 500 },
    { "accountId": "{{receivableAccount.response.body.$.accountId}}", "direction": "Debit", "amountMinorUnits": 500 },
    { "accountId": "{{bankAccount.response.body.$.accountId}}", "direction": "Credit", "amountMinorUnits": 1000 }
  ],
  "postedOnUtc": "2026-08-29T13:00:00Z"
}

###

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3 — Financing: unified instrument registration + straddling-cutoff plans
# ─────────────────────────────────────────────────────────────────────────────

### Register a debit instrument — routes to ILedgerApi (Asset / Bank)
# @name checkingInstrument
POST {{instruments}}
Content-Type: application/json

{ "type": "debit", "name": "Checking" }

### Register a cash instrument — routes to ILedgerApi (Asset / Cash)
# @name walletInstrument
POST {{instruments}}
Content-Type: application/json

{ "type": "cash", "name": "Wallet" }

### Register a credit instrument — routes to IFinancingApi (CreateCreditCard, cutoff day 15)
# @name visaInstrument
POST {{instruments}}
Content-Type: application/json

{ "type": "credit", "name": "Visa", "cutoffDate": 15 }

### Plan A — purchase ON the cutoff day (2026-03-15) → first installment closes into cycle 2026-03
# @name planOnCutoff
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 300000,
  "cardId": "{{visaInstrument.response.body.$.id}}",
  "installmentCount": 3,
  "purchaseDate": "2026-03-15"
}

### Plan B — purchase the DAY AFTER the cutoff (2026-03-16) → first installment closes into cycle 2026-04
# @name planAfterCutoff
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 300000,
  "cardId": "{{visaInstrument.response.body.$.id}}",
  "installmentCount": 3,
  "purchaseDate": "2026-03-16"
}

### Future schedule — plan A's first row is cycle 2026-03, plan B's is 2026-04 (rows drop off once accrued)
GET {{financing}}/cards/{{visaInstrument.response.body.$.id}}/future-schedule

### Plan C — WITH a split payload → writes exactly one financing_outbox_messages row in the same transaction as the plan (D8)
# @name planWithSplit
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 300000,
  "cardId": "{{visaInstrument.response.body.$.id}}",
  "installmentCount": 3,
  "purchaseDate": "2026-09-15",
  "split": [
    { "partyId": "00000000-0000-0000-0000-000000000001", "weight": 1 },
    { "partyId": "00000000-0000-0000-0000-000000000002", "weight": 1 }
  ]
}

# After running the requests above:
#   sqlite3 personalfinance.db "SELECT COUNT(*) FROM financing_outbox_messages;"  -- expect 1 (only plan C)
#   sqlite3 personalfinance.db "SELECT PaymentPlanId, Sequence, CycleYear, CycleMonth FROM financing_installments ORDER BY PaymentPlanId, Sequence;"

###

# ─────────────────────────────────────────────────────────────────────────────
# Phase 4 — Reversal Semantics (D12): reversal always succeeds; a paid installment
# also gets a compensating card-credit entry that nets the card's NEXT statement.
# ─────────────────────────────────────────────────────────────────────────────

### Register a credit card for the reversal walkthrough (cutoff day 10)
# @name reversalCard
POST {{instruments}}
Content-Type: application/json

{ "type": "credit", "name": "Reversal Demo Card", "cutoffDate": 10 }

### Plan R1 — one installment, purchase in a long-closed cycle so AccrueInstallments picks it up on the next tick
# @name planR1
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 120000,
  "cardId": "{{reversalCard.response.body.$.id}}",
  "installmentCount": 1,
  "purchaseDate": "2026-03-05"
}

### Future schedule — R1's row shows until AccrueInstallments runs (interval 1 min, also on startup), then it drops off
GET {{financing}}/cards/{{reversalCard.response.body.$.id}}/future-schedule

# Wait for accrual (Dr CardPurchases / Cr CardLiability, R1 rolled onto a MonthlyStatement). Then read the ids:
#   sqlite3 personalfinance.db "SELECT s.Id FROM financing_monthly_statements s JOIN financing_installments i ON i.StatementId=s.Id JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId JOIN financing_credit_cards c ON c.Id=p.CardId WHERE c.Name='Reversal Demo Card';"
#   sqlite3 personalfinance.db "SELECT t.Id FROM ledger_transactions t JOIN financing_installments i ON i.Id=t.InstallmentReferenceId JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId JOIN financing_credit_cards c ON c.Id=p.CardId WHERE c.Name='Reversal Demo Card' AND t.OriginalTransactionId IS NULL;"

### Pay R1's accrued statement (paste the statement id)
POST {{financing}}/statements/REPLACE_WITH_R1_STATEMENT_ID/pay
Content-Type: application/json

{ "bankAccountId": "{{checkingInstrument.response.body.$.id}}", "paidOnUtc": "2026-08-30T12:00:00Z" }

### Reverse R1's accrual transaction (paste the accrual txn id) — expect { "compensatingEntryPosted": true }
POST {{ledger}}/transactions/REPLACE_WITH_R1_ACCRUAL_TXN_ID/reversal

# After the reversal:
#   sqlite3 personalfinance.db "SELECT i.IsReversed FROM financing_installments i JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId JOIN financing_credit_cards c ON c.Id=p.CardId WHERE c.Name='Reversal Demo Card';"                          -- expect 1
#   sqlite3 personalfinance.db "SELECT CarriedCreditBalanceMinorUnits FROM financing_credit_cards WHERE Name='Reversal Demo Card';"                                                                                                                  -- expect 120000
#   net CardLiability for the card (storno + compensating cancel) — expect 0:
#   sqlite3 personalfinance.db "SELECT COALESCE(SUM(CASE e.Direction WHEN 'Debit' THEN e.AmountMinorUnits ELSE -e.AmountMinorUnits END),0) FROM ledger_entries e JOIN financing_credit_cards c ON c.LiabilityAccountId=e.AccountId WHERE c.Name='Reversal Demo Card';"

### Future schedule after the reversal — R1 is gone for good (a reversed installment never re-accrues)
GET {{financing}}/cards/{{reversalCard.response.body.$.id}}/future-schedule

### Plan R2 — a fresh installment on the SAME card, to prove the carried 120000 credit nets the NEXT statement
# @name planR2
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 200000,
  "cardId": "{{reversalCard.response.body.$.id}}",
  "installmentCount": 1,
  "purchaseDate": "2026-04-05"
}

# Wait for accrual again, then read R2's statement id:
#   sqlite3 personalfinance.db "SELECT s.Id, s.AmountDueMinorUnits FROM financing_monthly_statements s JOIN financing_installments i ON i.StatementId=s.Id JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId JOIN financing_credit_cards c ON c.Id=p.CardId WHERE c.Name='Reversal Demo Card' AND i.CycleMonth=4;"

### Pay R2's statement (paste the id) — amount due 200000, netted to Dr CardLiability 200000 / Cr Bank 80000 / Cr CardCredit 120000
POST {{financing}}/statements/REPLACE_WITH_R2_STATEMENT_ID/pay
Content-Type: application/json

{ "bankAccountId": "{{checkingInstrument.response.body.$.id}}", "paidOnUtc": "2026-08-30T13:00:00Z" }

# After paying R2:
#   sqlite3 personalfinance.db "SELECT CarriedCreditBalanceMinorUnits FROM financing_credit_cards WHERE Name='Reversal Demo Card';"  -- expect 0 (credit fully consumed)
#   the pay txn has 3 legs — Cr to the card's CreditAccountId = 120000, Cr to Bank = 80000, Dr CardLiability = 200000

### Control — reversing an accrued-but-UNPAID installment: plain storno, { "compensatingEntryPosted": false }, installment still flagged reversed
# (reverse any accrual txn whose installment was never rolled into a *paid* statement — e.g. one of the Phase 3 plan A/B accruals)

###

# ─────────────────────────────────────────────────────────────────────────────
# Phase 5 — Subscriptions: recurring charges that self-renew on a clock (US-5).
# Charged the moment you subscribe; RenewDueSubscriptions (interval 1 min, also
# on startup) owns every period after that. Depends on Ledger only.
# ─────────────────────────────────────────────────────────────────────────────

### Register a debit instrument to fund the subscriptions — routes to ILedgerApi (Asset / Bank)
# @name subsFunding
POST {{instruments}}
Content-Type: application/json

{ "type": "debit", "name": "Subscriptions Checking" }

### AC1 — subscribe once; the first period is charged synchronously inside the create handler
# @name netflix
POST {{subscriptions}}
Content-Type: application/json

{
  "name": "Netflix",
  "amountMinorUnits": 1500,
  "category": "Streaming",
  "fundingAccountId": "{{subsFunding.response.body.$.id}}",
  "frequency": "Monthly",
  "anchorDay": 15
}

### AC1 — the auto-provisioned "Netflix Expense" account already shows the first charge (+1500)
# Read its id, then hit the balance endpoint:
#   sqlite3 personalfinance.db "SELECT Id FROM ledger_accounts WHERE Name = 'Netflix Expense';"
GET {{ledger}}/accounts/REPLACE_WITH_NETFLIX_EXPENSE_ACCOUNT_ID/balance

### AC1 — the subscription is listed as active, NextDueDate = the next anchor-day occurrence
GET {{subscriptions}}/active

### AC2 — force a renewal: point NextDueDate into the past, then wait one scheduler tick (~60 s)
# @name spotify
POST {{subscriptions}}
Content-Type: application/json

{
  "name": "Spotify",
  "amountMinorUnits": 999,
  "category": "Streaming",
  "fundingAccountId": "{{subsFunding.response.body.$.id}}",
  "frequency": "Monthly",
  "anchorDay": 10
}

# Make Spotify due in the past (the scheduler renews `IsActive AND NextDueDate <= today`):
#   sqlite3 personalfinance.db "UPDATE subscriptions_templates SET NextDueDate = '2026-08-01' WHERE Name = 'Spotify';"
# After ~60 s:
#   - GET {{subscriptions}}/active shows Spotify's NextDueDate advanced one period and LastRenewalOnUtc stamped
#   - "Spotify Expense" balance rose by a second 999 charge
#   - a second ledger_transactions row is tagged with the subscription reference:
#     sqlite3 personalfinance.db "SELECT COUNT(*) FROM ledger_transactions WHERE SubscriptionReferenceId = (SELECT Id FROM subscriptions_templates WHERE Name = 'Spotify');"  -- expect 2
GET {{subscriptions}}/active

### AC3 — cancel stops future renewals; charges already generated are untouched
DELETE {{subscriptions}}/{{netflix.response.body.$.id}}

### AC3 — Netflix no longer listed; vw_active_subscriptions no longer returns it; the past +1500 charge is still in the Ledger
#   sqlite3 personalfinance.db "SELECT Name, IsActive FROM subscriptions_templates;"                     -- Netflix IsActive = 0
#   sqlite3 personalfinance.db "SELECT COUNT(*) FROM vw_active_subscriptions WHERE Name = 'Netflix';"    -- expect 0
GET {{subscriptions}}/active

### AC3 — cancelling again is idempotent → still 204
DELETE {{subscriptions}}/{{netflix.response.body.$.id}}

###
