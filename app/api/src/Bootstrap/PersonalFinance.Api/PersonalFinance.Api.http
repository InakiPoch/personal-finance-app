@api_HostAddress = https://localhost:7095
@ledger = {{api_HostAddress}}/v1/ledger
@instruments = {{api_HostAddress}}/v1/instruments
@financing = {{api_HostAddress}}/v1/financing
@subscriptions = {{api_HostAddress}}/v1/subscriptions
@parties = {{api_HostAddress}}/v1/parties

### Liveness probe (temporary — replaced by the real health check in Phase 8)
GET {{api_HostAddress}}/health
Accept: application/json

### Seed a bank account (Development-only endpoint)
# @name bankAccount
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Bank", "type": "Asset", "kind": "Bank" }

### Seed a cash account (Development-only endpoint)
# @name cashAccount
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Cash", "type": "Asset", "kind": "Cash" }

### Seed an expense account (Development-only endpoint)
# @name expenseAccount
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Groceries", "type": "Expense", "kind": "Expense" }

### Seed a receivable account (Development-only endpoint)
# @name receivableAccount
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Roommate", "type": "Asset", "kind": "Receivable" }

### Post a balanced transaction — Dr Groceries 1000 / Cr Bank 1000
# @name postedTransaction
POST {{ledger}}/transactions
Content-Type: application/json

{
  "lines": [
    { "accountId": "{{expenseAccount.response.body.$.accountId}}", "direction": "Debit", "amountMinorUnits": 1000 },
    { "accountId": "{{bankAccount.response.body.$.accountId}}", "direction": "Credit", "amountMinorUnits": 1000 }
  ],
  "postedOnUtc": "2026-08-29T12:00:00Z"
}

### Bank balance — expect -1000 ("-10.00 ARS")
GET {{ledger}}/accounts/{{bankAccount.response.body.$.accountId}}/balance

### Groceries balance — expect +1000 ("10.00 ARS")
GET {{ledger}}/accounts/{{expenseAccount.response.body.$.accountId}}/balance

### Reverse the transaction — expect compensatingEntryPosted: false
POST {{ledger}}/transactions/{{postedTransaction.response.body.$.transactionId}}/reversal

### Bank balance after reversal — expect 0
GET {{ledger}}/accounts/{{bankAccount.response.body.$.accountId}}/balance

### Receivable-shaped transaction — Dr Groceries 500 + Dr Roommate 500 / Cr Bank 1000
POST {{ledger}}/transactions
Content-Type: application/json

{
  "lines": [
    { "accountId": "{{expenseAccount.response.body.$.accountId}}", "direction": "Debit", "amountMinorUnits": 500 },
    { "accountId": "{{receivableAccount.response.body.$.accountId}}", "direction": "Debit", "amountMinorUnits": 500 },
    { "accountId": "{{bankAccount.response.body.$.accountId}}", "direction": "Credit", "amountMinorUnits": 1000 }
  ],
  "postedOnUtc": "2026-08-29T13:00:00Z"
}

###

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3 — Financing: unified instrument registration + straddling-cutoff plans
# ─────────────────────────────────────────────────────────────────────────────

### Register a debit instrument — routes to ILedgerApi (Asset / Bank)
# @name checkingInstrument
POST {{instruments}}
Content-Type: application/json

{ "type": "debit", "name": "Checking" }

### Register a cash instrument — routes to ILedgerApi (Asset / Cash)
# @name walletInstrument
POST {{instruments}}
Content-Type: application/json

{ "type": "cash", "name": "Wallet" }

### Register a credit instrument — routes to IFinancingApi (CreateCreditCard, cutoff day 15)
# @name visaInstrument
POST {{instruments}}
Content-Type: application/json

{ "type": "credit", "name": "Visa", "cutoffDate": 15 }

### Plan A — purchase ON the cutoff day (2026-03-15) → first installment closes into cycle 2026-03
# @name planOnCutoff
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 300000,
  "cardId": "{{visaInstrument.response.body.$.id}}",
  "installmentCount": 3,
  "purchaseDate": "2026-03-15"
}

### Plan B — purchase the DAY AFTER the cutoff (2026-03-16) → first installment closes into cycle 2026-04
# @name planAfterCutoff
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 300000,
  "cardId": "{{visaInstrument.response.body.$.id}}",
  "installmentCount": 3,
  "purchaseDate": "2026-03-16"
}

### Future schedule — plan A's first row is cycle 2026-03, plan B's is 2026-04 (rows drop off once accrued)
GET {{financing}}/cards/{{visaInstrument.response.body.$.id}}/future-schedule

### Plan C — WITH a split payload → writes exactly one financing_outbox_messages row in the same transaction as the plan (D8)
# @name planWithSplit
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 300000,
  "cardId": "{{visaInstrument.response.body.$.id}}",
  "installmentCount": 3,
  "purchaseDate": "2026-09-15",
  "split": [
    { "partyId": "00000000-0000-0000-0000-000000000001", "weight": 1 },
    { "partyId": "00000000-0000-0000-0000-000000000002", "weight": 1 }
  ]
}

# After running the requests above:
#   sqlite3 personalfinance.db "SELECT COUNT(*) FROM financing_outbox_messages;"  -- expect 1 (only plan C)
#   sqlite3 personalfinance.db "SELECT PaymentPlanId, Sequence, CycleYear, CycleMonth FROM financing_installments ORDER BY PaymentPlanId, Sequence;"

###

# ─────────────────────────────────────────────────────────────────────────────
# Phase 4 — Reversal Semantics (D12): reversal always succeeds; a paid installment
# also gets a compensating card-credit entry that nets the card's NEXT statement.
# ─────────────────────────────────────────────────────────────────────────────

### Register a credit card for the reversal walkthrough (cutoff day 10)
# @name reversalCard
POST {{instruments}}
Content-Type: application/json

{ "type": "credit", "name": "Reversal Demo Card", "cutoffDate": 10 }

### Plan R1 — one installment, purchase in a long-closed cycle so AccrueInstallments picks it up on the next tick
# @name planR1
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 120000,
  "cardId": "{{reversalCard.response.body.$.id}}",
  "installmentCount": 1,
  "purchaseDate": "2026-03-05"
}

### Future schedule — R1's row shows until AccrueInstallments runs (interval 1 min, also on startup), then it drops off
GET {{financing}}/cards/{{reversalCard.response.body.$.id}}/future-schedule

# Wait for accrual (Dr CardPurchases / Cr CardLiability, R1 rolled onto a MonthlyStatement). Then read the ids:
#   sqlite3 personalfinance.db "SELECT s.Id FROM financing_monthly_statements s JOIN financing_installments i ON i.StatementId=s.Id JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId JOIN financing_credit_cards c ON c.Id=p.CardId WHERE c.Name='Reversal Demo Card';"
#   sqlite3 personalfinance.db "SELECT t.Id FROM ledger_transactions t JOIN financing_installments i ON i.Id=t.InstallmentReferenceId JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId JOIN financing_credit_cards c ON c.Id=p.CardId WHERE c.Name='Reversal Demo Card' AND t.OriginalTransactionId IS NULL;"

### Pay R1's accrued statement (paste the statement id)
POST {{financing}}/statements/REPLACE_WITH_R1_STATEMENT_ID/pay
Content-Type: application/json

{ "bankAccountId": "{{checkingInstrument.response.body.$.id}}", "paidOnUtc": "2026-08-30T12:00:00Z" }

### Reverse R1's accrual transaction (paste the accrual txn id) — expect { "compensatingEntryPosted": true }
POST {{ledger}}/transactions/REPLACE_WITH_R1_ACCRUAL_TXN_ID/reversal

# After the reversal:
#   sqlite3 personalfinance.db "SELECT i.IsReversed FROM financing_installments i JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId JOIN financing_credit_cards c ON c.Id=p.CardId WHERE c.Name='Reversal Demo Card';"                          -- expect 1
#   sqlite3 personalfinance.db "SELECT CarriedCreditBalanceMinorUnits FROM financing_credit_cards WHERE Name='Reversal Demo Card';"                                                                                                                  -- expect 120000
#   net CardLiability for the card (storno + compensating cancel) — expect 0:
#   sqlite3 personalfinance.db "SELECT COALESCE(SUM(CASE e.Direction WHEN 'Debit' THEN e.AmountMinorUnits ELSE -e.AmountMinorUnits END),0) FROM ledger_entries e JOIN financing_credit_cards c ON c.LiabilityAccountId=e.AccountId WHERE c.Name='Reversal Demo Card';"

### Future schedule after the reversal — R1 is gone for good (a reversed installment never re-accrues)
GET {{financing}}/cards/{{reversalCard.response.body.$.id}}/future-schedule

### Plan R2 — a fresh installment on the SAME card, to prove the carried 120000 credit nets the NEXT statement
# @name planR2
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 200000,
  "cardId": "{{reversalCard.response.body.$.id}}",
  "installmentCount": 1,
  "purchaseDate": "2026-04-05"
}

# Wait for accrual again, then read R2's statement id:
#   sqlite3 personalfinance.db "SELECT s.Id, s.AmountDueMinorUnits FROM financing_monthly_statements s JOIN financing_installments i ON i.StatementId=s.Id JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId JOIN financing_credit_cards c ON c.Id=p.CardId WHERE c.Name='Reversal Demo Card' AND i.CycleMonth=4;"

### Pay R2's statement (paste the id) — amount due 200000, netted to Dr CardLiability 200000 / Cr Bank 80000 / Cr CardCredit 120000
POST {{financing}}/statements/REPLACE_WITH_R2_STATEMENT_ID/pay
Content-Type: application/json

{ "bankAccountId": "{{checkingInstrument.response.body.$.id}}", "paidOnUtc": "2026-08-30T13:00:00Z" }

# After paying R2:
#   sqlite3 personalfinance.db "SELECT CarriedCreditBalanceMinorUnits FROM financing_credit_cards WHERE Name='Reversal Demo Card';"  -- expect 0 (credit fully consumed)
#   the pay txn has 3 legs — Cr to the card's CreditAccountId = 120000, Cr to Bank = 80000, Dr CardLiability = 200000

### Control — reversing an accrued-but-UNPAID installment: plain storno, { "compensatingEntryPosted": false }, installment still flagged reversed
# (reverse any accrual txn whose installment was never rolled into a *paid* statement — e.g. one of the Phase 3 plan A/B accruals)

###

# ─────────────────────────────────────────────────────────────────────────────
# Phase 5 — Subscriptions: recurring charges that self-renew on a clock (US-5).
# Charged the moment you subscribe; RenewDueSubscriptions (interval 1 min, also
# on startup) owns every period after that. Depends on Ledger only.
# ─────────────────────────────────────────────────────────────────────────────

### Register a debit instrument to fund the subscriptions — routes to ILedgerApi (Asset / Bank)
# @name subsFunding
POST {{instruments}}
Content-Type: application/json

{ "type": "debit", "name": "Subscriptions Checking" }

### AC1 — subscribe once; the first period is charged synchronously inside the create handler
# @name netflix
POST {{subscriptions}}
Content-Type: application/json

{
  "name": "Netflix",
  "amountMinorUnits": 1500,
  "category": "Streaming",
  "fundingAccountId": "{{subsFunding.response.body.$.id}}",
  "frequency": "Monthly",
  "anchorDay": 15
}

### AC1 — the auto-provisioned "Netflix Expense" account already shows the first charge (+1500)
# Read its id, then hit the balance endpoint:
#   sqlite3 personalfinance.db "SELECT Id FROM ledger_accounts WHERE Name = 'Netflix Expense';"
GET {{ledger}}/accounts/REPLACE_WITH_NETFLIX_EXPENSE_ACCOUNT_ID/balance

### AC1 — the subscription is listed as active, NextDueDate = the next anchor-day occurrence
GET {{subscriptions}}/active

### AC2 — force a renewal: point NextDueDate into the past, then wait one scheduler tick (~60 s)
# @name spotify
POST {{subscriptions}}
Content-Type: application/json

{
  "name": "Spotify",
  "amountMinorUnits": 999,
  "category": "Streaming",
  "fundingAccountId": "{{subsFunding.response.body.$.id}}",
  "frequency": "Monthly",
  "anchorDay": 10
}

# Make Spotify due in the past (the scheduler renews `IsActive AND NextDueDate <= today`):
#   sqlite3 personalfinance.db "UPDATE subscriptions_templates SET NextDueDate = '2026-08-01' WHERE Name = 'Spotify';"
# After ~60 s:
#   - GET {{subscriptions}}/active shows Spotify's NextDueDate advanced one period and LastRenewalOnUtc stamped
#   - "Spotify Expense" balance rose by a second 999 charge
#   - a second ledger_transactions row is tagged with the subscription reference:
#     sqlite3 personalfinance.db "SELECT COUNT(*) FROM ledger_transactions WHERE SubscriptionReferenceId = (SELECT Id FROM subscriptions_templates WHERE Name = 'Spotify');"  -- expect 2
GET {{subscriptions}}/active

### AC3 — cancel stops future renewals; charges already generated are untouched
DELETE {{subscriptions}}/{{netflix.response.body.$.id}}

### AC3 — Netflix no longer listed; vw_active_subscriptions no longer returns it; the past +1500 charge is still in the Ledger
#   sqlite3 personalfinance.db "SELECT Name, IsActive FROM subscriptions_templates;"                     -- Netflix IsActive = 0
#   sqlite3 personalfinance.db "SELECT COUNT(*) FROM vw_active_subscriptions WHERE Name = 'Netflix';"    -- expect 0
GET {{subscriptions}}/active

### AC3 — cancelling again is idempotent → still 204
DELETE {{subscriptions}}/{{netflix.response.body.$.id}}

###

# ─────────────────────────────────────────────────────────────────────────────
# Phase 6 — Parties: third-party shared-expense tracking as a management view over
# Ledger receivable accounts (D1). A party's balance is ALWAYS a live read of its
# Ledger Receivable account — Parties never keeps its own balance number.
#   • Debit/cash path (RegisterSharedExpense): the full Dr Gasto + Dr PorCobrar / Cr Banco
#     posts synchronously and is the end-to-end reversal-cascade proof (D12 step 4).
#   • Card-split path: OnPaymentPlanCreated (first real Outbox consumer, D8/RF-3) only
#     records the split intent; the receivable becomes real cycle by cycle in a
#     split-aware AccrueInstallments (D11 — an un-accrued installment is not a liability).
#   • CorrectExpenseSplit NEVER posts to the Ledger — the storno's mirrored Cr Receivable
#     leg already corrected the account (RNF-5); it only advances the split metadata.
#
# NOTE — EF Core stores Guids as UPPERCASE TEXT in SQLite. The {{...response.body}} ids
# below come back lowercase, so wrap them in UPPER(...) inside the sqlite3 checks
# (e.g. WHERE Id = UPPER('{{alice.response.body.$.id}}')) or the comparison silently misses.
# ─────────────────────────────────────────────────────────────────────────────

# ---- 6a. Debit path: shared expense + reversal auto-correct --------------------

### Fund the debit-path shared expenses — routes to ILedgerApi (Asset / Bank)
# @name p6Funding
POST {{instruments}}
Content-Type: application/json

{ "type": "debit", "name": "Shared Wallet" }

### Expense bucket for the shared expense (Development-only endpoint)
# @name p6Expense
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "Shared Dinner", "type": "Expense", "kind": "Expense" }

### Create a party — the handler provisions its Ledger Receivable account ("Alice Receivable")
# @name alice
POST {{parties}}
Content-Type: application/json

{ "name": "Alice" }

### Create a second party for the card-split walk below
# @name bob
POST {{parties}}
Content-Type: application/json

{ "name": "Bob" }

### Register a 2-way shared expense — total 9000, holder implicit (weight index 0), Alice weight 1
### → Dr Shared Dinner 4500 + Dr "Alice Receivable" 4500 / Cr Shared Wallet 9000, tagged SplitReferenceId
# @name sharedDinner
POST {{parties}}/shared-expenses
Content-Type: application/json

{
  "description": "Tasting menu",
  "totalMinorUnits": 9000,
  "expenseAccountId": "{{p6Expense.response.body.$.accountId}}",
  "fundingAccountId": "{{p6Funding.response.body.$.id}}",
  "incurredOnUtc": "2026-08-30T20:00:00Z",
  "participants": [
    { "partyId": "{{alice.response.body.$.id}}", "weight": 1 }
  ]
}

### Alice's current-account balance — expect +4500 ("45.00 ARS"), a live read of her Receivable
GET {{parties}}/{{alice.response.body.$.id}}/balance

### Alice's timeline — one 'Shared expense' row, running balance 4500
GET {{parties}}/{{alice.response.body.$.id}}/timeline

# Read the ledger transaction id of the shared-expense posting (the endpoint returns the SplitReferenceId, not the txn id):
#   sqlite3 personalfinance.db "SELECT Id FROM ledger_transactions WHERE SplitReferenceId = '{{sharedDinner.response.body.$.splitReferenceId}}' AND OriginalTransactionId IS NULL;"

### Reverse the shared-expense transaction (paste the id) — expect { "compensatingEntryPosted": false } (no installment on the debit path)
POST {{ledger}}/transactions/REPLACE_WITH_SHARED_DINNER_TXN_ID/reversal

### Alice's balance after the reversal — expect 0: the storno's mirrored Cr "Alice Receivable" 4500 cancels it, no Parties-side ledger post
GET {{parties}}/{{alice.response.body.$.id}}/balance

### Alice's timeline after the reversal — a second 'Reversal' row, running balance back to 0
GET {{parties}}/{{alice.response.body.$.id}}/timeline

# Metadata check — the cascade advanced the split's own counter, nothing else:
#   sqlite3 personalfinance.db "SELECT TotalMinorUnits, AccruedReceivableMinorUnits, ReversedReceivableMinorUnits FROM parties_expense_splits WHERE Id = '{{sharedDinner.response.body.$.splitReferenceId}}';"  -- expect 9000 | 4500 | 4500

# ---- 6b. Card-split path: accrue → pay → reverse a cycle ----------------------

### Register a credit card for the split walk (cutoff day 10)
# @name p6Card
POST {{instruments}}
Content-Type: application/json

{ "type": "credit", "name": "Shared Card", "cutoffDate": 10 }

### Split payment plan — 300000 over 3 installments, purchase in a long-closed cycle so AccrueInstallments picks it up.
### Split weights: holder implicit + Alice 1 + Bob 1 → 3-way per installment. Writes ONE financing_outbox_messages row (D8).
# @name p6SplitPlan
POST {{financing}}/payment-plans
Content-Type: application/json

{
  "amountMinorUnits": 300000,
  "cardId": "{{p6Card.response.body.$.id}}",
  "installmentCount": 3,
  "purchaseDate": "2026-02-05",
  "split": [
    { "partyId": "{{alice.response.body.$.id}}", "weight": 1 },
    { "partyId": "{{bob.response.body.$.id}}", "weight": 1 }
  ]
}

# After the OutboxWorker drains (~5 s), OnPaymentPlanCreated has recorded the split intent + called LinkSplitAsync:
#   sqlite3 personalfinance.db "SELECT Source, SourceReferenceId, AccruedReceivableMinorUnits FROM parties_expense_splits WHERE SourceReferenceId = '{{p6SplitPlan.response.body.$.paymentPlanId}}';"  -- expect 'CardPlan' | <plan id> | 0
#   sqlite3 personalfinance.db "SELECT SplitReferenceId FROM financing_payment_plans WHERE Id = '{{p6SplitPlan.response.body.$.paymentPlanId}}';"                                                       -- not null
#   sqlite3 personalfinance.db "SELECT PartyId, ReceivableAccountId FROM financing_payment_plan_split_participants WHERE PaymentPlanId = '{{p6SplitPlan.response.body.$.paymentPlanId}}';"              -- 2 rows, ReceivableAccountId populated

### Alice's balance right after the plan — still 0: the receivable is NOT owed at plan-creation (D11), only cycle by cycle
GET {{parties}}/{{alice.response.body.$.id}}/balance

# Let AccrueInstallments tick (interval 1 min, also on startup). Each closed cycle posts, tagged InstallmentReferenceId + SplitReferenceId:
#   Dr CardPurchases 33334 + Dr "Alice Receivable" 33333 + Dr "Bob Receivable" 33333 / Cr CardLiability 100000   (100000 / 3, odd cent to the holder)
# and calls IPartiesApi.RecordSplitAccrualAsync so parties_expense_splits.AccruedReceivableMinorUnits tracks progress.

### Alice's balance after N cycles have closed — expect ≈ 33333 × (closed cycles)
GET {{parties}}/{{alice.response.body.$.id}}/balance

### Alice's timeline — one 'Card installment' row per accrued cycle
GET {{parties}}/{{alice.response.body.$.id}}/timeline

# Read the statement id and one accrued cycle's accrual txn id:
#   sqlite3 personalfinance.db "SELECT s.Id, s.AmountDueMinorUnits FROM financing_monthly_statements s JOIN financing_installments i ON i.StatementId=s.Id JOIN financing_payment_plans p ON p.Id=i.PaymentPlanId WHERE p.Id='{{p6SplitPlan.response.body.$.paymentPlanId}}' ORDER BY s.CycleYear, s.CycleMonth;"
#   sqlite3 personalfinance.db "SELECT t.Id FROM ledger_transactions t JOIN financing_installments i ON i.Id=t.InstallmentReferenceId WHERE i.PaymentPlanId='{{p6SplitPlan.response.body.$.paymentPlanId}}' AND t.OriginalTransactionId IS NULL ORDER BY t.PostedOnUtc;"

### Pay the earliest accrued statement (paste the id)
POST {{financing}}/statements/REPLACE_WITH_P6_STATEMENT_ID/pay
Content-Type: application/json

{ "bankAccountId": "{{p6Funding.response.body.$.id}}", "paidOnUtc": "2026-08-31T10:00:00Z" }

### Reverse that cycle's accrual transaction (paste the id) — installment was paid, so expect { "compensatingEntryPosted": true }
### Cascade: storno's Cr "Alice Receivable" 33333 + Cr "Bob Receivable" 33333 drop the balances; CorrectExpenseSplitAsync bumps ReversedReceivableMinorUnits by 66666 (no ledger post)
POST {{ledger}}/transactions/REPLACE_WITH_P6_ACCRUAL_TXN_ID/reversal

### Alice's balance after the cascade — dropped by that cycle's 33333
GET {{parties}}/{{alice.response.body.$.id}}/balance

# Cascade metadata check:
#   sqlite3 personalfinance.db "SELECT AccruedReceivableMinorUnits, ReversedReceivableMinorUnits FROM parties_expense_splits WHERE SourceReferenceId = '{{p6SplitPlan.response.body.$.paymentPlanId}}';"  -- ReversedReceivableMinorUnits grew by 66666

# ---- 6c. Inbox dedup (RNF-2) -------------------------------------------------

# Re-deliver the PaymentPlanCreated event and confirm OnPaymentPlanCreated is a no-op the second time:
#   sqlite3 personalfinance.db "UPDATE financing_outbox_messages SET ProcessedOnUtc = NULL, Attempts = 0 WHERE Id = (SELECT Id FROM financing_outbox_messages ORDER BY Id DESC LIMIT 1);"
# Restart the host (or wait one poll). The consumer sees its parties_inbox_consumed row and returns early:
#   sqlite3 personalfinance.db "SELECT COUNT(*) FROM parties_expense_splits WHERE SourceReferenceId = '{{p6SplitPlan.response.body.$.paymentPlanId}}';"  -- still 1
#   sqlite3 personalfinance.db "SELECT COUNT(*) FROM parties_inbox_consumed WHERE Consumer = 'Parties';"                                       -- unchanged

# ---- 6d. OutboxHealthCheck degradation (RNF-7) ------------------------------

# OutboxHealthCheck is registered (AddHealthChecks().AddCheck<OutboxHealthCheck>("outbox")) but not yet mapped to an
# HTTP route — /health is still the Phase-8 stub. Inspect the backlog directly instead:
#   1. Pause the worker: stop the host, POST another split plan is not possible offline, so instead leave a message pending —
#      sqlite3 personalfinance.db "UPDATE financing_outbox_messages SET ProcessedOnUtc = NULL WHERE Id = (SELECT Id FROM financing_outbox_messages ORDER BY Id DESC LIMIT 1);"
#   2. sqlite3 personalfinance.db "SELECT COUNT(*) AS pending, MIN(OccurredOnUtc) AS oldest FROM financing_outbox_messages WHERE ProcessedOnUtc IS NULL;"
#   OutboxHealthCheck reports Degraded while pending > 0, and Unhealthy once (now - oldest) > OutboxOptions.StalenessThreshold (default 5 min).

###

# ─────────────────────────────────────────────────────────────────────────────
# Phase 7 — Reporting: read-only cross-module dashboards over the vw_* views only
# (D5 / RNF-6). The Reporting project holds zero reference to any module's .Contracts
# or implementation assembly; it opens a read-only SQLite connection and reads
# vw_ledger_monthly_expenses / vw_card_liability_accrued / vw_card_future_schedule /
# vw_current_account_timeline. The HTTP surface is host-owned under /v1/reports.
#
# Two documented quirks this walk makes visible (Phase 10 doc-sync candidates — NOT
# defects to fix here; Reporting consumes each view as published):
#   • RF-1 leak — vw_ledger_monthly_expenses filters Type='Expense' AND Kind<>'Receivable',
#     so per-card *Purchases* buckets (Kind='Expense') ride along in the "debit & cash"
#     summary that US-1 AC2 says should exclude credit.
#   • RF-2 card-identity gap — /card-due-by-month presents Accrued (keyed by the Ledger
#     liability account NAME) and Future (keyed by the Financing CardId GUID) as two
#     tagged buckets; there is no shared join key across the two view surfaces.
# ─────────────────────────────────────────────────────────────────────────────

@reports = {{api_HostAddress}}/v1/reports

# ---- 7a. Seed a self-contained slice (every posting lands in month 2026-07) ----

### Bank funding account
# @name p7Bank
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "P7 Bank", "type": "Asset", "kind": "Bank" }

### Cash funding account — proves the "and cash" half of the monthly summary
# @name p7Cash
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "P7 Wallet", "type": "Asset", "kind": "Cash" }

### Expense bucket — groceries
# @name p7Groceries
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "P7 Groceries", "type": "Expense", "kind": "Expense" }

### Expense bucket — rent
# @name p7Rent
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "P7 Rent", "type": "Expense", "kind": "Expense" }

### Expense bucket — snacks (cash-funded)
# @name p7Snacks
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "P7 Snacks", "type": "Expense", "kind": "Expense" }

### Expense bucket for the manual accrual posting — Kind='Expense', so this is the RF-1 leak source
# @name p7CardPurchases
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "P7 Card Purchases", "type": "Expense", "kind": "Expense" }

### Expense bucket for the shared expense
# @name p7Shared
POST {{ledger}}/accounts
Content-Type: application/json

{ "name": "P7 Shared Dining", "type": "Expense", "kind": "Expense" }

### CardLiability account — stands in for an accrued cycle so vw_card_liability_accrued has a row
# @name p7CardLiab
POST {{ledger}}/accounts
Content-Type: application/json

